{
  "name": "plan-vivo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "visor": "tsx visor/bin/visor.ts",
    "validar": "tsx visor/bin/validar.ts",
    "tiempos": "tsx tiempos/src/main.ts",
